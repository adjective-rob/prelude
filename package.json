{
  "name": "prelude-context",
  "version": "1.12.0",
  "mcpName": "io.github.adjective-rob/prelude",
  "description": "The open standard for expressing and maintaining machine-readable context about a codebase",
  "type": "module",
  "bin": {
    "prelude": "dist/bin/prelude.js"
  },
  "files": [
    "dist/**/*",
    "schemas/**/*",
    "README.md",
    "spec.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch bin/prelude.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "cli",
    "context",
    "ai",
    "agents",
    "llm",
    "codebase",
    "prelude",
    "machine-readable",
    "developer-tools",
    "mcp",
    "model-context-protocol",
    "agents-md",
    "claude",
    "cursor",
    "codebase-map"
  ],
  "author": "Rob Murtha (https://adjective.us)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adjective-rob/prelude.git"
  },
  "homepage": "https://github.com/adjective-rob/prelude#readme",
  "bugs": {
    "url": "https://github.com/adjective-rob/prelude/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cac": "^7.1.0",
    "chokidar": "^6.0.0",
    "colorette": "^2.0.20",
    "log-symbols": "^7.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
