{
  "name": "prelude-context",
  "version": "1.8.1",
  "description": "The open standard for expressing and maintaining machine-readable context about a codebase",
  "type": "module",
  "bin": {
    "prelude": "dist/bin/prelude.js"
  },
  "files": [
    "dist/**/*",
    "schemas/**/*",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch bin/prelude.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "cli",
    "context",
    "ai",
    "agents",
    "llm",
    "codebase",
    "prelude",
    "machine-readable",
    "developer-tools"
  ],
  "author": "Rob Hocking <rob@useadjective.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/adjective-rob/prelude.git"
  },
  "homepage": "https://github.com/adjective-rob/prelude#readme",
  "bugs": {
    "url": "https://github.com/adjective-rob/prelude/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "colorette": "^2.0.20",
    "log-symbols": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
