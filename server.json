{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.adjective-rob/prelude",
  "description": "Committed, machine-readable codebase context and code map that tells agents where to look.",
  "repository": {
    "url": "https://github.com/adjective-rob/prelude",
    "source": "github"
  },
  "version": "1.11.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "prelude-context",
      "version": "1.11.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
